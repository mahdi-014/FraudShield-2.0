# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg2://fraudshield:fraudshield_password@localhost:5432/fraudshield_db
TEST_DATABASE_URL=postgresql+psycopg2://fraudshield:fraudshield_password@localhost:5432/fraudshield_test_db

# Legacy Scoring API Key (minimum 24 characters)
FRAUDSHIELD_API_KEY=YOUR_LEGACY_SCORING_API_KEY_MIN_24_CHARS_HERE

# Service Caller Credentials: comma-separated token:identity pairs (tokens min 24 chars)
# Example: svc_secret_checkout_abcdef123456:checkout_service,svc_secret_payments_abcdef123456:payments_service
FRAUDSHIELD_SERVICE_KEYS=YOUR_SERVICE_KEY_1_MIN_24_CHARS:checkout_service,YOUR_SERVICE_KEY_2_MIN_24_CHARS:payments_service

# Analyst Credentials: comma-separated token:identity pairs (tokens min 24 chars)
# Example: analyst_secret_jane_abcdef123456:analyst_jane,analyst_secret_bob_abcdef123456:analyst_bob
FRAUDSHIELD_ANALYST_KEYS=YOUR_ANALYST_KEY_1_MIN_24_CHARS:analyst_jane,YOUR_ANALYST_KEY_2_MIN_24_CHARS:analyst_bob

# Path to trained artifacts
FRAUDSHIELD_ARTIFACT_DIR=artifacts

# Empty means same-origin only; Vite uses its development proxy. No wildcard.
FRAUDSHIELD_CORS_ORIGINS=
# Optional database schema. Normal application schema is public.
FRAUDSHIELD_DB_SCHEMA=public
