# FraudShield 2.0 Environment Configuration

# General Application Settings
APP_NAME="FraudShield 2.0"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=fraudshield-super-secret-key-change-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fraudshield
POSTGRES_PASSWORD=fraudshield_secure_pass
POSTGRES_DB=fraudshield_db
DATABASE_URL=postgresql://fraudshield:fraudshield_secure_pass@localhost:5432/fraudshield_db

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=fraudshield_graph_pass

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM & GenAI API Settings (Supports OpenAI, Azure OpenAI, or Local Mock Engine)
LLM_PROVIDER=openai
LLM_API_KEY=mock-key-for-development
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database Settings (pgvector used via PostgreSQL)
VECTOR_DB_URL=postgresql://fraudshield:fraudshield_secure_pass@localhost:5432/fraudshield_db

# Risk Scoring Weights (Configurable Risk Fusion)
WEIGHT_ML_FRAUD=0.35
WEIGHT_ANOMALY=0.15
WEIGHT_BEHAVIOR=0.20
WEIGHT_RULE=0.15
WEIGHT_GRAPH=0.15
